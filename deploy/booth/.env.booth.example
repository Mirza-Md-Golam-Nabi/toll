# ============================================================
#  Toll Management — BOOTH PC (.env)
#  Copy to the project root as ".env", then run deploy\booth\install.bat
# ============================================================
APP_NAME="Toll Management"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://toll-management.test
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=toll_management
DB_USERNAME=root
DB_PASSWORD=

# An operator shift is 8 hours — keep the session alive for the whole shift.
SESSION_DRIVER=database
SESSION_LIFETIME=720
CACHE_STORE=database
QUEUE_CONNECTION=sync

# --- Toll settings ---
TOLL_MODE=booth
TOLL_BOOTH_CODE=B01

# Leave both empty to run stand-alone (no central server).
TOLL_CENTRAL_URL=https://toll.example.com
TOLL_SYNC_TOKEN=change-me-to-the-same-long-random-token-as-central

# escpos = print directly to the 58mm thermal printer
TOLL_PRINTER_DRIVER=escpos
# windows = shared printer name | network = printer IP
TOLL_PRINTER_CONNECTOR=windows
TOLL_PRINTER_TARGET=POS58
TOLL_PRINTER_CHARS=32
