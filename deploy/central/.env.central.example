# ============================================================
#  Toll Management — CENTRAL (online) SERVER (.env)
#  Copy to the project root as ".env", then run deploy/central/deploy.sh
# ============================================================
APP_NAME="Toll Management"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://toll.example.com
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=toll_management
DB_USERNAME=toll
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

# --- Toll settings ---
TOLL_MODE=central
# Shared secret every booth sends. Generate one: php -r "echo bin2hex(random_bytes(32));"
TOLL_SYNC_TOKEN=change-me-to-a-long-random-token
TOLL_PRINTER_DRIVER=browser
